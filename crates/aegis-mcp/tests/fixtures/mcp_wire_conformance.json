{
  "description": "Golden wire fixtures for the aegis-mcp JSON-RPC/stdio surface. Each case is one session: 'requests' are the exact stdin lines in order, 'frames' is the expected subset of each stdout response frame, matched by request id in any arrival order (the server writes responses in task-completion order, like the reference MCP SDK), and 'error_code' pins a JSON-RPC error instead of a result. 'text.frame' indexes the expected frame list and the target response is located by that frame's request id. Replayed by tests/mcp_wire_conformance.rs; edit both together.",
  "cases": [
    {
      "name": "initialize echoes a supported protocol version",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-03-26\",\"capabilities\":{},\"clientInfo\":{\"name\":\"conformance\",\"version\":\"0.0.1\"}},\"id\":1}"
      ],
      "frames": [
        {
          "id": 1,
          "error_code": null,
          "match": {
            "result.protocolVersion": "2025-03-26",
            "result.serverInfo.name": "aegis-mcp",
            "result.capabilities.tools.listChanged": false
          }
        }
      ]
    },
    {
      "name": "initialize falls back to the latest supported version",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"1999-01-01\",\"capabilities\":{},\"clientInfo\":{\"name\":\"conformance\",\"version\":\"0.0.1\"}},\"id\":2}"
      ],
      "frames": [
        {
          "id": 2,
          "error_code": null,
          "match": {
            "result.protocolVersion": "2025-06-18"
          }
        }
      ]
    },
    {
      "name": "notifications/initialized produces no response frame",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\"},\"id\":3}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"
      ],
      "frames": [
        {
          "id": 3,
          "error_code": null,
          "match": {}
        }
      ]
    },
    {
      "name": "tools/list exposes the seven tools with object schemas",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"tools/list\",\"params\":{},\"id\":4}"
      ],
      "frames": [
        {
          "id": 4,
          "error_code": null,
          "match": {
            "result.tools.0.name": "scan_string",
            "result.tools.0.inputSchema.type": "object",
            "result.tools.1.name": "scan_file",
            "result.tools.2.name": "scan_dir",
            "result.tools.3.name": "scan_env",
            "result.tools.4.name": "list_patterns",
            "result.tools.5.name": "list_categories",
            "result.tools.6.name": "update_bundle"
          }
        }
      ],
      "text": null
    },
    {
      "name": "ping answers an empty result",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"id\":5}"
      ],
      "frames": [
        {
          "id": 5,
          "error_code": null,
          "match": {}
        }
      ]
    },
    {
      "name": "unknown tool is an isError result, not a protocol error",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"no_such_tool\"},\"id\":6}"
      ],
      "frames": [
        {
          "id": 6,
          "error_code": null,
          "match": {
            "result.isError": true
          }
        }
      ],
      "text": {
        "frame": 0,
        "must_contain": ["unknown tool"]
      }
    },
    {
      "name": "sandbox escape via tools/call is an isError result",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"scan_file\",\"arguments\":{\"path\":\"/etc/passwd\"}},\"id\":7}"
      ],
      "frames": [
        {
          "id": 7,
          "error_code": null,
          "match": {
            "result.isError": true
          }
        }
      ],
      "text": {
        "frame": 0,
        "must_contain": ["outside allowed directory"],
        "must_not_contain": ["root:"]
      }
    },
    {
      "name": "tools/call without a name is invalid params",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"arguments\":{}},\"id\":8}"
      ],
      "frames": [
        {
          "id": 8,
          "error_code": -32602,
          "match": {}
        }
      ]
    },
    {
      "name": "resources/list returns empty list (prompts/list also implemented)",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"resources/list\",\"params\":{},\"id\":9}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"prompts/list\",\"params\":{},\"id\":10}"
      ],
      "frames": [
        {
          "id": 9,
          "error_code": null,
          "match": {
            "result.resources": []
          }
        },
        {
          "id": 10,
          "error_code": null,
          "match": {
            "result.prompts": []
          }
        }
      ]
    },
    {
      "name": "malformed JSON is a parse error with null id",
      "requests": [
        "{not json"
      ],
      "frames": [
        {
          "id": null,
          "error_code": -32700,
          "match": {}
        }
      ]
    },
    {
      "name": "resources/templates/list returns an empty template list",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"resources/templates/list\",\"params\":{},\"id\":11}"
      ],
      "frames": [
        {
          "id": 11,
          "error_code": null,
          "match": {
            "result.resourceTemplates": []
          }
        }
      ]
    },
    {
      "name": "batched JSON-RPC lines are refused, one message per stdio frame",
      "requests": [
        "[{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"id\":12}]"
      ],
      "frames": [
        {
          "id": null,
          "error_code": -32600,
          "match": {}
        }
      ]
    },
    {
      "name": "a cancellation for an unknown request is ignored and the session stays live",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/cancelled\",\"params\":{\"requestId\":999,\"reason\":\"unknown id\"}}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"id\":13}"
      ],
      "frames": [
        {
          "id": 13,
          "error_code": null,
          "match": {}
        }
      ]
    },
    {
      "name": "a cancelled in-flight request produces no response frame",
      "requests": [
        "{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"scan_string\",\"arguments\":{\"content\":\"const x = 1;\",\"source\":\"cancellation\"}},\"id\":14}",
        "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/cancelled\",\"params\":{\"requestId\":14,\"reason\":\"client timeout\"}}"
      ],
      "frames": []
    }
  ]
}
